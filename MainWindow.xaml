<Window x:Class="Moreno.Voice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Moreno.Voice.Controls"
        Title="Moreno Voice" Width="124" Height="124" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
    <Grid x:Name="OrbSurface" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Orb_MouseLeftButtonDown" MouseMove="Orb_MouseMove" MouseLeftButtonUp="Orb_MouseLeftButtonUp">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Settings" Click="Settings_Click" />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Viewbox Stretch="Uniform"><controls:OrbControl x:Name="Orb" /></Viewbox>
    </Grid>
</Window>
